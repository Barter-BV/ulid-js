{
  "name": "@barter-bv/ulid-js",
  "version": "2.0.0",
  "description": "pULID - Pixie ULID implementation for JavaScript. A 128-bit identifier combining timestamp, scope, and entropy with ULID and UUIDv4 compatibility.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "ulid",
    "uuid",
    "identifier",
    "pulid",
    "pixie",
    "sortable",
    "entropy",
    "timestamp",
    "scope"
  ],
  "author": "Pixie Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Barter-BV/ulid-js.git"
  },
  "bugs": {
    "url": "https://github.com/Barter-BV/ulid-js/issues"
  },
  "homepage": "https://github.com/Barter-BV/ulid-js#readme",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc",
    "test:runtime": "node test/runner.js",
    "test:types": "tsc -p test/types/tsconfig.json",
    "test": "npm run build && npm run test:runtime && npm run test:types",
    "prepublishOnly": "npm test && npm pack --dry-run",
    "release": "sh scripts/release.sh",
    "lint": "npm run typecheck"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  },
  "dependencies": {}
}
